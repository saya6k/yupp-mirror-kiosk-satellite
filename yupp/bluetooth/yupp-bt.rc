# Turns Bluetooth on once, on the first boot: Radxa's image leaves it off, and
# Kiosk Satellite's Bluetooth proxy needs it. Turned off later, it stays off.
service yupp_bt_default /system/bin/sh -c "[ \"$$(getprop persist.yupp.bt_default)\" = 1 ] || { svc bluetooth enable && setprop persist.yupp.bt_default 1; }"
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    start yupp_bt_default
