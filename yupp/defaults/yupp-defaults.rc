# Settings the mirror starts with, set once on the first boot so that changing
# them later sticks (yupp-defaults.sh); it runs on every boot.
service yupp_defaults /system/bin/sh /system/etc/yupp-defaults.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    start yupp_defaults

# The kernel (Radxa's config) has CONFIG_TEST_POWER=y, whose dummy battery
# reads 50% and makes Kiosk Satellite report a battery the mirror does not
# have. Take it away before Kiosk Satellite starts; the dummy mains supply
# stays online.
on early-boot
    write /sys/module/test_power/parameters/battery_present false
